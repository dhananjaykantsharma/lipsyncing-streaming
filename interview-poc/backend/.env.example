OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# `modal serve server.py` (dev, lives only while that terminal runs) gives the "-dev" URL:
#   wss://dhananjay-sharma--musetalk-lipsync-musetalkinference-web-dev.modal.run/ws-stream
# `modal deploy server.py` (permanent) gives the same URL without "-dev":
MODAL_WS_URL=wss://dhananjay-sharma--musetalk-lipsync-musetalkinference-web.modal.run/ws-stream

# seconds without a turn before the Modal connection is closed (lets the GPU scale to zero)
MODAL_IDLE_CLOSE_S=180
